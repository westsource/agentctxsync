# ============================================================
# Agent Context Sync — server environment template
# Copy to `.env` and fill in real values. NEVER commit .env.
#   cp server/.env.example server/.env
# `server/_run_local.py` loads this file into the environment before starting.
# ============================================================

# --- PostgreSQL (used by the app via HERMES_SYNC_PG_DSN; deploy-server.sh
#     can build the DSN from these three values) ---
POSTGRES_USER=agentctxsync
POSTGRES_PASSWORD=change-me-strong-password
POSTGRES_DB=agentctxsync

# --- Required ---
# PostgreSQL connection string
HERMES_SYNC_PG_DSN=postgresql://agentctxsync:change-me@localhost:5432/agentctxsync
# Master API key (sync-API credential that bypasses workspace/quota checks)
HERMES_SYNC_MASTER_KEY=change-me
# JWT signing secret (openssl rand -hex 32); unset => random per process
HERMES_SYNC_JWT_SECRET=change-me

# --- Optional: Web UI ---
# JWT expiry hours (default 24)
HERMES_SYNC_TOKEN_EXPIRE=24
# Canonical public address baked into shipped client packages (e.g. https://sync.example.com)
HERMES_SYNC_PUBLIC_URL=
# Announcement banner feed (absolute http(s) URL; browser-fetched; empty = off)
HERMES_SYNC_ANNOUNCEMENTS_URL=

# --- Optional: email verification / password reset (dormant unless all four
#     SMTP_* values below are set) ---
HERMES_SYNC_SMTP_HOST=
HERMES_SYNC_SMTP_PORT=465
HERMES_SYNC_SMTP_USER=
HERMES_SYNC_SMTP_PASSWORD=
HERMES_SYNC_SMTP_FROM=
# Outbound-mail ceiling per calendar day, counted in the DB (0 = no cap)
HERMES_SYNC_MAIL_DAILY_CAP=200
