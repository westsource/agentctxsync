# ============================================================
# Agent Contexts Sync — server environment template
# Copy to `.env` and fill in real values. NEVER commit .env.
#   cp server/.env.example server/.env
# ============================================================

# --- PostgreSQL (used by server.py via HERMES_SYNC_PG_DSN; deploy-server.sh
#     can build the DSN from these three values) ---
POSTGRES_USER=agentctxsync
POSTGRES_PASSWORD=change-me-strong-password
POSTGRES_DB=agentctxsync

# --- Agent Contexts Sync server (server.py) ---
# PostgreSQL connection string
HERMES_SYNC_PG_DSN=postgresql://agentctxsync:change-me@localhost:5432/agentctxsync
# Master API key (non-sync admin key)
HERMES_SYNC_MASTER_KEY=change-me
# JWT signing secret (openssl rand -hex 32)
HERMES_SYNC_JWT_SECRET=change-me
# JWT expiry hours (default 24)
HERMES_SYNC_TOKEN_EXPIRE=24
